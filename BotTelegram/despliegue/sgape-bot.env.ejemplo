# Copia este archivo a /etc/sgape-bot.env en el servidor y llena los valores.
# Permisos: sudo chmod 600 /etc/sgape-bot.env  (solo root puede leerlo)
# NUNCA subas el archivo real a Git ni lo pegues en un chat.

# Telegram: token que da @BotFather
TELEGRAM_BOT_TOKEN=

# Groq: clave creada en https://console.groq.com/keys
GROQ_API_KEY=
# Opcional: otro modelo con soporte de herramientas (por defecto llama-3.3-70b-versatile)
# GROQ_MODELO=openai/gpt-oss-120b
# Opcional: preguntas al modelo por chat cada 10 minutos (por defecto 20)
# SGAPE_LIMITE_PREGUNTAS=20

# Oracle Autonomous Database (usa un usuario propio del bot, no ADMIN)
SGAPE_DB_USUARIO=SGAPE_BOT
SGAPE_DB_CLAVE=
SGAPE_DB_DATASOURCE=sgape_low
SGAPE_DB_WALLET=/opt/sgape-bot/wallet
