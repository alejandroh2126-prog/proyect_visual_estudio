[Unit]
Description=Bot de Telegram de SGAPE
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sgape
WorkingDirectory=/opt/sgape-bot
EnvironmentFile=/etc/sgape-bot.env
ExecStart=/opt/sgape-bot/sgape-bot
Restart=always
RestartSec=10
# Endurecimiento basico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
