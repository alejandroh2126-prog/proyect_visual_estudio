[Unit]
Description=Bot de Telegram de SGAPE
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sgape
WorkingDirectory=/opt/sgape-bot
EnvironmentFile=/etc/sgape-bot.env
# Hora de Colombia: "hoy", las ventas del dia y el cierre de las 7 p. m. usan esta zona
Environment=TZ=America/Bogota
ExecStart=/opt/sgape-bot/sgape-bot
Restart=always
RestartSec=10
# Endurecimiento basico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
