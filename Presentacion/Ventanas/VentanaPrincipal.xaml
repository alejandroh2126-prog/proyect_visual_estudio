<Window x:Class="Presentacion.Ventanas.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:c="clr-namespace:Presentacion.Comun"
        xmlns:vm="clr-namespace:Presentacion.ViewModels"
        Title="SGAPE" Width="1280" Height="800" MinWidth="1050" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{md:MaterialDesignFont}">
    <md:DialogHost Identifier="Raiz" CloseOnClickAway="False">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra superior -->
            <md:ColorZone Grid.ColumnSpan="2" Mode="PrimaryDark" Padding="16,10">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <md:PackIcon Kind="StorefrontOutline" Width="28" Height="28" VerticalAlignment="Center" />
                        <TextBlock Text="SGAPE" FontSize="22" FontWeight="Bold" Margin="8,0,24,0" VerticalAlignment="Center" />
                        <Border Background="White" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <ComboBox Width="300" ItemsSource="{Binding Emprendimientos}" SelectedItem="{Binding EmprendimientoActual}"
                                      md:HintAssist.Hint="Elige un emprendimiento" Foreground="#212121" ToolTip="Emprendimiento con el que trabajas" />
                        </Border>
                        <TextBlock Text="Crea tu primer emprendimiento en la sección Emprendimientos" Margin="16,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding SinEmprendimientos, Converter={StaticResource BoolAVisible}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Command="{Binding VerPlanCommand}" ToolTip="Ver mi plan" Margin="0,0,16,0" Padding="12,2" Height="28"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="White">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="CrownOutline" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TextoPlan}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <md:PackIcon Kind="AccountCircle" Width="24" Height="24" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding NombreUsuario}" Margin="6,0,16,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Command="{Binding CerrarSesionCommand}" ToolTip="Cerrar sesión">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Logout" VerticalAlignment="Center" />
                                <TextBlock Text="Salir" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </md:ColorZone>

            <!-- Menu lateral -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding Secciones}" SelectedItem="{Binding SeccionActual}" Margin="0,8,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:Seccion}">
                            <StackPanel Orientation="Horizontal" Margin="8,6">
                                <md:PackIcon Kind="{Binding Icono}" Width="22" Height="22" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Nombre}" FontSize="15" Margin="14,0,0,0" VerticalAlignment="Center" />
                                <md:PackIcon Kind="LockOutline" Width="16" Height="16" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.6"
                                             ToolTip="Plan Pro" Visibility="{Binding Bloqueada, Converter={StaticResource BoolAVisible}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Contenido de la seccion -->
            <Grid Grid.Row="1" Grid.Column="1">
                <ContentControl Content="{Binding SeccionActual.ViewModel}" Margin="24,20,24,12" />
                <ProgressBar VerticalAlignment="Top" IsIndeterminate="True" Height="3"
                             Visibility="{Binding SeccionActual.ViewModel.Ocupado, Converter={StaticResource BoolAVisible}}" />
                <md:Snackbar MessageQueue="{x:Static c:Notificador.Cola}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
            </Grid>
        </Grid>
    </md:DialogHost>
</Window>
