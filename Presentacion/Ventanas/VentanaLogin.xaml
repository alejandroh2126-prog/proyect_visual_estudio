<Window x:Class="Presentacion.Ventanas.VentanaLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SGAPE - Iniciar sesión" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{md:MaterialDesignFont}" FontSize="14.5">
    <StackPanel>
        <md:ColorZone Mode="PrimaryMid" Padding="0" ClipToBounds="True">
            <Grid>
                <Ellipse Width="220" Height="220" Fill="#1AFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-90,-60,0" IsHitTestVisible="False" />
                <Ellipse Width="110" Height="110" Fill="#14FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,120,-50" IsHitTestVisible="False" />
                <StackPanel Margin="30,28">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="52" Height="52" CornerRadius="16" Background="#33FFFFFF">
                            <md:PackIcon Kind="StorefrontOutline" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SGAPE" FontSize="30" FontWeight="Black" />
                            <TextBlock Text="Tu negocio en orden" FontSize="14" Opacity="0.85" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Sistema de Gestión y Administración de Emprendimientos" Opacity="0.85" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="15" />
                </StackPanel>
            </Grid>
        </md:ColorZone>

        <StackPanel Margin="28,24,28,28">
            <TextBlock x:Name="Titulo" Text="Iniciar sesión" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,16" />

            <TextBox x:Name="CajaNombre" Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="Nombre completo *"
                     MaxLength="100" Margin="0,0,0,14" Visibility="Collapsed" />
            <TextBox x:Name="CajaCorreo" Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="Correo *"
                     MaxLength="150" Margin="0,0,0,14" />
            <PasswordBox x:Name="CajaClave" Style="{StaticResource MaterialDesignOutlinedPasswordBox}" md:HintAssist.Hint="Contraseña *"
                         MaxLength="100" Margin="0,0,0,14" />
            <PasswordBox x:Name="CajaConfirmacion" Style="{StaticResource MaterialDesignOutlinedPasswordBox}" md:HintAssist.Hint="Confirmar contraseña *"
                         md:HintAssist.HelperText="Mínimo 8 caracteres, con letras y números." MaxLength="100" Margin="0,0,0,20" Visibility="Collapsed" />

            <TextBlock x:Name="Mensaje" Foreground="#C62828" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />
            <ProgressBar x:Name="Cargando" IsIndeterminate="True" Margin="0,0,0,12" Visibility="Collapsed" />

            <Button x:Name="BotonPrincipal" Content="Entrar" Style="{StaticResource MaterialDesignRaisedButton}" IsDefault="True"
                    Height="46" FontSize="16" md:ButtonAssist.CornerRadius="12" Click="Principal_Click" />
            <Button x:Name="BotonCambiar" Content="¿No tienes cuenta? Crear cuenta" Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="0,10,0,0" Click="Cambiar_Click" />
        </StackPanel>
    </StackPanel>
</Window>
