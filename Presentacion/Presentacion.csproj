<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Logica\Logica.csproj" />
    <ProjectReference Include="..\Entidades\Entidades.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Interfaz Material Design para WPF y MVVM con generadores de codigo -->
    <PackageReference Include="MaterialDesignThemes" Version="5.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Presentacion</RootNamespace>
    <AssemblyName>SGAPE</AssemblyName>
    <Version>2.0.0</Version>
    <Product>SGAPE</Product>
    <Company>Universidad Popular del Cesar</Company>
  </PropertyGroup>

</Project>
