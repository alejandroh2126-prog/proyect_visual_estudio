<UserControl x:Class="Presentacion.Vistas.MiPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Mi plan" Style="{StaticResource TituloSeccion}" />

            <!-- Estado actual -->
            <md:Card Style="{StaticResource Tarjeta}">
                <DockPanel>
                    <md:PackIcon DockPanel.Dock="Left" Kind="CrownOutline" Width="40" Height="40" VerticalAlignment="Center"
                                 Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,16,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding Titulo}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detalle}" TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </md:Card>

            <!-- Comparacion de planes -->
            <UniformGrid Columns="2">
                <md:Card Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="$0" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="Gratis" FontSize="22" FontWeight="Bold" />
                        </DockPanel>
                        <TextBlock Text="Para empezar a ordenar tu negocio." Opacity="0.7" Margin="0,4,0,10" />
                        <ItemsControl ItemsSource="{Binding IncluyeGratis}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <md:PackIcon Kind="Check" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </md:Card>
                <md:Card Style="{StaticResource Tarjeta}" Background="{DynamicResource PrimaryHueDarkBrush}"
                         Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PrecioPro}" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="Pro" FontSize="22" FontWeight="Bold" />
                        </DockPanel>
                        <TextBlock Text="Todo SGAPE, para crecer sin límites." Opacity="0.85" Margin="0,4,0,10" />
                        <ItemsControl ItemsSource="{Binding IncluyePro}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <md:PackIcon Kind="Check" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </md:Card>
            </UniformGrid>

            <!-- Activar con codigo -->
            <md:Card Style="{StaticResource Tarjeta}">
                <StackPanel>
                    <TextBlock Text="Activar Pro con un código" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,10"
                               Text="Al pagar el plan Pro recibes un código de activación (PRO-XXXX-XXXX). Escríbelo aquí: los días se suman a los que te queden." />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BotonPrincipal}" Command="{Binding ActivarCommand}" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal"><md:PackIcon Kind="KeyVariant" /><TextBlock Text="Activar" Margin="6,0,0,0" /></StackPanel>
                        </Button>
                        <TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="Código de activación" CharacterCasing="Upper" MaxLength="20" FontFamily="Consolas">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ActivarCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                </StackPanel>
            </md:Card>

            <TextBlock TextWrapping="Wrap" Opacity="0.65" Margin="0,4,12,0"
                       Text="Todos los usuarios nuevos tienen 14 días de Pro gratis. Si Pro vence, tus datos no se borran: solo se bloquean las funciones Pro hasta que lo actives de nuevo." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
