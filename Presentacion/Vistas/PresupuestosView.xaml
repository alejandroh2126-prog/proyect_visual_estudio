<UserControl x:Class="Presentacion.Vistas.PresupuestosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:v="clr-namespace:Presentacion.Vistas">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <ComboBox DockPanel.Dock="Right" Width="160" ItemsSource="{Binding Meses}" SelectedItem="{Binding Mes}" VerticalAlignment="Top"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}" md:HintAssist.Hint="Mes" />
            <TextBlock Text="Límite de gasto por categoría" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Opacity="0.75" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="El gastado, el porcentaje y el estado los calcula Oracle (procedimiento sp_sg_presupuestos_estado). Alerta desde el 80 %." />
        <v:BarraCrud DockPanel.Dock="Top" />

        <DataGrid ItemsSource="{Binding Vista}" SelectedItem="{Binding Seleccionado}" Style="{StaticResource Tabla}">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditarCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="*" />
                <DataGridTextColumn Header="Límite" Binding="{Binding MontoLimite, Converter={StaticResource Moneda}}" />
                <DataGridTextColumn Header="Gastado" Binding="{Binding Gastado, Converter={StaticResource Moneda}}" />
                <DataGridTextColumn Header="Disponible" Binding="{Binding Disponible, Converter={StaticResource Moneda}}" />
                <DataGridTemplateColumn Header="Uso" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <ProgressBar Value="{Binding PorcentajeUso, Mode=OneWay}" Maximum="100" Height="14"
                                             Foreground="{Binding Estado, Converter={StaticResource EstadoAColor}}" />
                                <TextBlock Text="{Binding PorcentajeUso, Converter={StaticResource Porcentaje}}" HorizontalAlignment="Center" FontSize="11" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Estado">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Estado}" FontWeight="Bold" Foreground="{Binding Estado, Converter={StaticResource EstadoAColor}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
