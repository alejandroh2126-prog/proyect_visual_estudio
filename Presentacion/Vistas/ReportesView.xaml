<UserControl x:Class="Presentacion.Vistas.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:c="clr-namespace:Presentacion.Comun">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignRaisedButton}" Command="{Binding GenerarPdfCommand}" Height="42">
                    <StackPanel Orientation="Horizontal"><md:PackIcon Kind="FilePdfBox" /><TextBlock Text="Generar reporte PDF" Margin="6,0,0,0" /></StackPanel>
                </Button>
                <TextBlock Text="Reportes" Style="{StaticResource TituloSeccion}" />
            </DockPanel>
            <TextBlock Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Todos los números salen de los paquetes pkg_sg_reportes y pkg_sg_nomina de Oracle. El mismo PDF lo envía el bot de Telegram con /reporte." />

            <UniformGrid Columns="4">
                <md:Card Style="{StaticResource Tarjeta}">
                    <StackPanel><TextBlock Text="Ventas históricas" Style="{StaticResource EtiquetaKpi}" />
                        <TextBlock Text="{Binding Datos.Ventas.TotalHistorico, Converter={StaticResource Moneda}}" Style="{StaticResource ValorKpi}" />
                        <TextBlock Text="{Binding Datos.Ventas.CantidadVentas, StringFormat='{}{0} ventas'}" Style="{StaticResource EtiquetaKpi}" /></StackPanel>
                </md:Card>
                <md:Card Style="{StaticResource Tarjeta}">
                    <StackPanel><TextBlock Text="Balance" Style="{StaticResource EtiquetaKpi}" />
                        <TextBlock Text="{Binding Datos.Finanzas.Balance, Converter={StaticResource Moneda}}" Style="{StaticResource ValorKpi}"
                                   Foreground="{Binding Datos.Finanzas.Balance, Converter={StaticResource EstadoAColor}}" /></StackPanel>
                </md:Card>
                <md:Card Style="{StaticResource Tarjeta}">
                    <StackPanel><TextBlock Text="Valor del inventario" Style="{StaticResource EtiquetaKpi}" />
                        <TextBlock Text="{Binding Datos.ValorInventario, Converter={StaticResource Moneda}}" Style="{StaticResource ValorKpi}" /></StackPanel>
                </md:Card>
                <md:Card Style="{StaticResource Tarjeta}">
                    <StackPanel><TextBlock Text="Nómina neta" Style="{StaticResource EtiquetaKpi}" />
                        <TextBlock Text="{Binding Datos.Nomina.NominaNeta, Converter={StaticResource Moneda}}" Style="{StaticResource ValorKpi}" /></StackPanel>
                </md:Card>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <md:Card Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <md:PackIcon Kind="ChartBar" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Ventas por mes" Style="{StaticResource TituloTarjeta}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <c:GraficaBarras Datos="{Binding VentasPorMes}" Height="260" Relleno="{DynamicResource PrimaryHueMidBrush}" TextoVacio="Aún no hay ventas" />
                    </StackPanel>
                </md:Card>
                <md:Card Grid.Column="1" Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <md:PackIcon Kind="Trophy" Width="22" Height="22" Foreground="#FFB300" VerticalAlignment="Center" />
                            <TextBlock Text="Más vendidos (ingresos)" Style="{StaticResource TituloTarjeta}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <c:GraficaBarras Datos="{Binding TopProductos}" Horizontal="True" Height="260" TextoVacio="Aún no hay ventas" />
                    </StackPanel>
                </md:Card>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <md:Card Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <md:PackIcon Kind="ChartPie" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Gastos por categoría" Style="{StaticResource TituloTarjeta}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:GraficaDona Datos="{Binding GastosPorCategoria}" Height="220" Centro="{Binding TotalGastos}" CentroDetalle="en gastos"
                                           Background="{DynamicResource MaterialDesignCardBackground}" TextoVacio="Aún no hay gastos" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding GastosPorCategoria}" ItemTemplate="{StaticResource Leyenda}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </md:Card>
                <md:Card Grid.Column="1" Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <md:PackIcon Kind="AccountCash" Width="22" Height="22" Foreground="#8E24AA" VerticalAlignment="Center" />
                            <TextBlock Text="Nómina del mes" Style="{StaticResource TituloTarjeta}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:GraficaDona Datos="{Binding Nomina}" Height="220" Centro="{Binding Datos.Nomina.NominaMensual, Converter={StaticResource Moneda}}" CentroDetalle="mensual"
                                           Background="{DynamicResource MaterialDesignCardBackground}" TextoVacio="Aún no hay trabajadores activos" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Nomina}" ItemTemplate="{StaticResource Leyenda}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </md:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
