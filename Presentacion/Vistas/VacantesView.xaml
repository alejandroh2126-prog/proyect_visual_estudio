<UserControl x:Class="Presentacion.Vistas.VacantesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:v="clr-namespace:Presentacion.Vistas">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Vacantes y hojas de vida" Style="{StaticResource TituloSeccion}" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.75" Margin="0,-6,0,12"
                   Text="Los aspirantes ven las vacantes abiertas en el bot de Telegram (/vacantes) y envían su hoja de vida sin instalar la aplicación." />
        <v:BarraCrud DockPanel.Dock="Top">
            <v:BarraCrud.Extra>
                <Button Style="{StaticResource BotonBarra}" Command="{Binding AbrirCerrarCommand}">
                    <StackPanel Orientation="Horizontal"><md:PackIcon Kind="LockOpenVariantOutline" /><TextBlock Text="Abrir / cerrar" Margin="6,0,0,0" /></StackPanel>
                </Button>
            </v:BarraCrud.Extra>
        </v:BarraCrud>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DataGrid ItemsSource="{Binding Vista}" SelectedItem="{Binding Seleccionado}" Style="{StaticResource Tabla}">
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditarCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N.º" Binding="{Binding Id}" />
                    <DataGridTextColumn Header="Vacante" Binding="{Binding Titulo}" Width="2*" />
                    <DataGridTextColumn Header="Cargo" Binding="{Binding Cargo}" Width="*" />
                    <DataGridTextColumn Header="Salario" Binding="{Binding SalarioBase, Converter={StaticResource Moneda}}" />
                    <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="*" />
                    <DataGridTextColumn Header="Publicada" Binding="{Binding FechaPublicacion, Converter={StaticResource Fecha}}" />
                    <DataGridTextColumn Header="Cierra" Binding="{Binding FechaCierre, Converter={StaticResource Fecha}}" />
                    <DataGridTextColumn Header="Hojas de vida" Binding="{Binding Postulaciones}" />
                    <DataGridTemplateColumn Header="Estado">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Estado}" FontWeight="SemiBold" Foreground="{Binding Estado, Converter={StaticResource EstadoAColor}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="1" Margin="0,16,0,8" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Postulaciones de la vacante seleccionada" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button DockPanel.Dock="Left" Style="{StaticResource BotonPrincipal}" Command="{Binding VerHojaDeVidaCommand}">
                    <StackPanel Orientation="Horizontal"><md:PackIcon Kind="FileDownloadOutline" /><TextBlock Text="Ver hoja de vida" Margin="6,0,0,0" /></StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource BotonBarra}" Command="{Binding ContratarCommand}">
                    <StackPanel Orientation="Horizontal"><md:PackIcon Kind="AccountCheckOutline" /><TextBlock Text="Contratar" Margin="6,0,0,0" /></StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource BotonBarra}" Command="{Binding RechazarCommand}">
                    <StackPanel Orientation="Horizontal"><md:PackIcon Kind="AccountRemoveOutline" /><TextBlock Text="Rechazar" Margin="6,0,0,0" /></StackPanel>
                </Button>
            </DockPanel>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Postulaciones}" SelectedItem="{Binding PostulacionSeleccionada}" Style="{StaticResource Tabla}">
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding VerHojaDeVidaCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, Converter={StaticResource Fecha}, ConverterParameter=hora}" />
                    <DataGridTextColumn Header="Tipo doc." Binding="{Binding TipoDocumento}" />
                    <DataGridTextColumn Header="Número" Binding="{Binding NumeroDocumento}" />
                    <DataGridTextColumn Header="Nombres" Binding="{Binding Nombre}" Width="*" />
                    <DataGridTextColumn Header="Apellidos" Binding="{Binding Apellido}" Width="*" />
                    <DataGridTextColumn Header="Celular" Binding="{Binding Telefono}" />
                    <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="*" />
                    <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="*" />
                    <DataGridTextColumn Header="Archivo" Binding="{Binding CvBytes, Converter={StaticResource Tamano}}" />
                    <DataGridTemplateColumn Header="Estado">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Estado, Converter={StaticResource EstadoPostulacion}}" FontWeight="SemiBold"
                                           Foreground="{Binding Estado, Converter={StaticResource EstadoAColor}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
