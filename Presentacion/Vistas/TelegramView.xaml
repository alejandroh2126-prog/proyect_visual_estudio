<UserControl x:Class="Presentacion.Vistas.TelegramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <!-- Numero de cada paso -->
        <Style x:Key="NumeroPaso" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="TextoNumero" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidForegroundBrush}" />
        </Style>
        <Style x:Key="Funcion" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ Encabezado ============ -->
            <md:Card Grid.ColumnSpan="2" UniformCornerRadius="20" Margin="0,0,14,16" md:ElevationAssist.Elevation="Dp3" Background="#229ED9">
                <Grid ClipToBounds="True">
                    <Ellipse Width="300" Height="300" Fill="#1AFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-80,0" IsHitTestVisible="False" />
                    <Ellipse Width="160" Height="160" Fill="#14FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,260,-90" IsHitTestVisible="False" />
                    <DockPanel Margin="28,24">
                        <Border DockPanel.Dock="Left" Width="76" Height="76" CornerRadius="38" Background="White" VerticalAlignment="Center">
                            <md:PackIcon Kind="Send" Width="40" Height="40" Foreground="#229ED9" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </Border>
                        <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SGAPE en tu celular con Telegram" FontSize="28" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
                            <TextBlock FontSize="16" Foreground="White" Opacity="0.92" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Consulta tu negocio desde donde estés, aunque el computador esté apagado. El bot te avisa solo cuando algo necesita tu atención." />
                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,10,0,0">
                                <Run Text="Bot: " /><Run Text="{Binding ArrobaBot, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </md:Card>

            <!-- ============ Vincular (lo principal) ============ -->
            <md:Card Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="26">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <md:PackIcon Kind="LinkVariant" Width="30" Height="30" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Vincula tu celular en 3 pasos" FontSize="23" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Subtitulo}" Margin="0,0,0,22"
                               Text="Solo se hace una vez. Desde ese momento el bot solo te muestra TUS emprendimientos." />

                    <!-- Paso 1 -->
                    <DockPanel Margin="0,0,0,22">
                        <Border Style="{StaticResource NumeroPaso}"><TextBlock Text="1" Style="{StaticResource TextoNumero}" /></Border>
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Text="Genera tu código" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Es de un solo uso y vence en 10 minutos." FontSize="15" Opacity="0.7" Margin="0,2,0,12" />
                            <Button Command="{Binding GenerarCodigoCommand}" Style="{StaticResource BotonPrincipal}" Height="52" Padding="22,0"
                                    HorizontalAlignment="Left" md:ButtonAssist.CornerRadius="14">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="KeyVariant" Width="22" Height="22" VerticalAlignment="Center" />
                                    <TextBlock Text="Generar código" FontSize="17" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Codigo grande -->
                            <Border Margin="0,16,0,0" CornerRadius="16" Padding="22,16" HorizontalAlignment="Left" BorderThickness="2"
                                    BorderBrush="{DynamicResource PrimaryHueMidBrush}" Background="{DynamicResource MaterialDesignPaper}"
                                    Visibility="{Binding CodigoVigente, Converter={StaticResource BoolAVisible}}">
                                <StackPanel>
                                    <TextBlock Text="TU CÓDIGO" FontSize="13" FontWeight="Bold" Opacity="0.6" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CodigoGrande}" FontSize="60" FontWeight="Bold" FontFamily="Consolas"
                                                   Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding CopiarCommand}" ToolTip="Copiar «/vincular código»"
                                                Margin="12,0,0,0" Width="52" Height="52">
                                            <md:PackIcon Kind="ContentCopy" Width="26" Height="26" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="TimerSandComplete" VerticalAlignment="Center" Foreground="#FB8C00" />
                                        <TextBlock Text="{Binding Vence}" FontSize="15" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Vence}" FontSize="15" Foreground="#E53935" Margin="0,10,0,0"
                                       Visibility="{Binding CodigoVigente, Converter={StaticResource BoolAInvisible}}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Paso 2 -->
                    <DockPanel Margin="0,0,0,22">
                        <Border Style="{StaticResource NumeroPaso}"><TextBlock Text="2" Style="{StaticResource TextoNumero}" /></Border>
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Text="Ábrelo en Telegram" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock FontSize="15" Opacity="0.75" Margin="0,2,0,12" TextWrapping="Wrap"
                                       Text="Con el código generado, este botón abre el bot y te vincula con un solo toque." />
                            <Button Command="{Binding AbrirTelegramCommand}" Height="52" Padding="22,0" HorizontalAlignment="Left"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#229ED9" BorderBrush="#229ED9" Foreground="White"
                                    md:ButtonAssist.CornerRadius="14">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Send" Width="22" Height="22" VerticalAlignment="Center" />
                                    <TextBlock Text="Abrir en Telegram" FontSize="17" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Paso 3 -->
                    <DockPanel>
                        <Border Style="{StaticResource NumeroPaso}"><TextBlock Text="3" Style="{StaticResource TextoNumero}" /></Border>
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Text="Toca «Iniciar» en el chat" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock FontSize="15" Opacity="0.75" Margin="0,2,0,0" TextWrapping="Wrap">
                                <Run Text="Si Telegram no abre solo, busca " /><Run Text="{Binding ArrobaBot, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=", toca «Vincular mi cuenta» y envía el código de 6 números." />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </md:Card>

            <!-- ============ Columna derecha ============ -->
            <StackPanel Grid.Row="1" Grid.Column="1">
                <!-- Estado -->
                <md:Card Style="{StaticResource Tarjeta}">
                    <DockPanel>
                        <Border Style="{StaticResource IconoKpi}" Background="#22229ED9" Width="60" Height="60">
                            <md:PackIcon Kind="CellphoneLink" Width="32" Height="32" Foreground="#229ED9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Celulares vinculados" Style="{StaticResource EtiquetaKpi}" FontSize="15" />
                            <TextBlock Text="{Binding ChatsVinculados}" FontSize="34" FontWeight="Bold" />
                        </StackPanel>
                    </DockPanel>
                </md:Card>

                <!-- Lo que puede hacer -->
                <md:Card Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Con el bot puedes" Style="{StaticResource TituloTarjeta}" FontSize="18" Margin="0,0,0,14" />
                        <DockPanel Style="{StaticResource Funcion}">
                            <md:PackIcon Kind="ChartBoxOutline" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" FontSize="15"><Run Text="Ver el resumen y las ventas de hoy" FontWeight="SemiBold" /><LineBreak /><Run Text="Con un botón, sin escribir comandos." /></TextBlock>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Funcion}">
                            <md:PackIcon Kind="FilePdfBox" Width="24" Height="24" Foreground="#E53935" />
                            <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" FontSize="15"><Run Text="Recibir el reporte en PDF" FontWeight="SemiBold" /><LineBreak /><Run Text="Listo para reenviar a tu socio o contador." /></TextBlock>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Funcion}">
                            <md:PackIcon Kind="RobotHappyOutline" Width="24" Height="24" Foreground="#5E35B1" />
                            <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" FontSize="15"><Run Text="Preguntar como a una persona" FontWeight="SemiBold" /><LineBreak /><Run Text="«¿Cuánto vendí esta semana?», «Registra un gasto de 50.000»." /></TextBlock>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Funcion}">
                            <md:PackIcon Kind="BellRingOutline" Width="24" Height="24" Foreground="#FB8C00" />
                            <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" FontSize="15"><Run Text="Recibir alertas automáticas" FontWeight="SemiBold" /><LineBreak /><Run Text="Stock bajo, presupuestos al 80 %, hojas de vida nuevas y el cierre del día a las 7 p. m." /></TextBlock>
                        </DockPanel>
                        <TextBlock Text="Las alertas y el bot del dueño son del plan Pro." FontSize="13" Opacity="0.6" />
                    </StackPanel>
                </md:Card>

                <!-- Aspirantes -->
                <md:Card Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <md:PackIcon Kind="BriefcaseAccountOutline" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="¿Buscas personal?" Style="{StaticResource TituloTarjeta}" FontSize="18" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock FontSize="15" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Los aspirantes NO necesitan vincularse: en el bot solo ven «Ver vacantes» y envían su hoja de vida. Comparte este enlace:" />
                        <Border CornerRadius="12" Background="{DynamicResource MaterialDesignPaper}" Padding="14,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}" Command="{Binding CopiarEnlaceVacantesCommand}" ToolTip="Copiar enlace">
                                    <md:PackIcon Kind="ContentCopy" />
                                </Button>
                                <TextBlock Text="{Binding EnlaceVacantes}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </md:Card>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
