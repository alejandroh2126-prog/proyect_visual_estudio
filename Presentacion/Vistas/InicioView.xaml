<UserControl x:Class="Presentacion.Vistas.InicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:c="clr-namespace:Presentacion.Comun">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,8">

            <!-- ============ Encabezado con saludo ============ -->
            <md:Card UniformCornerRadius="20" Margin="0,0,14,16" md:ElevationAssist.Elevation="Dp3" Background="{DynamicResource PrimaryHueMidBrush}">
                <Grid ClipToBounds="True">
                    <Border CornerRadius="20" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#40000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Ellipse Width="260" Height="260" Fill="#18FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,-40,0" IsHitTestVisible="False" />
                    <Ellipse Width="140" Height="140" Fill="#14FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,200,-70" IsHitTestVisible="False" />
                    <DockPanel Margin="26,22">
                        <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}" Command="{Binding RecargarCommand}" ToolTip="Recargar"
                                Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" VerticalAlignment="Top">
                            <md:PackIcon Kind="Refresh" Width="26" Height="26" />
                        </Button>
                        <StackPanel>
                            <TextBlock Text="{Binding Saludo}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" />
                            <TextBlock Text="{Binding Fecha}" FontSize="15" Opacity="0.85" Margin="0,2,0,0" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" />
                            <Border Background="#33FFFFFF" CornerRadius="14" Padding="12,5" Margin="0,12,0,0" HorizontalAlignment="Left"
                                    Visibility="{Binding Resumen, Converter={StaticResource NuloAVisible}}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="StoreOutline" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" />
                                    <TextBlock Text="{Binding Resumen.Nombre}" Margin="6,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" />
                                    <TextBlock Text="{Binding Resumen.Sector, StringFormat=' · {0}'}" Opacity="0.85" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </md:Card>

            <md:Card Style="{StaticResource Tarjeta}" Visibility="{Binding Resumen, Converter={StaticResource NuloAVisible}, ConverterParameter=invertir}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="RocketLaunchOutline" Width="40" Height="40" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="Bienvenido a SGAPE" Style="{StaticResource TituloTarjeta}" FontSize="19" />
                        <TextBlock Text="Empieza creando tu emprendimiento en la sección Emprendimientos. Luego registra cargos, productos y ventas: aquí verás tus gráficas."
                                   TextWrapping="Wrap" Margin="0,6,0,0" FontSize="15" Opacity="0.8" />
                    </StackPanel>
                </StackPanel>
            </md:Card>

            <StackPanel Visibility="{Binding Resumen, Converter={StaticResource NuloAVisible}}">
                <!-- ============ Indicadores ============ -->
                <UniformGrid Columns="4">
                    <md:Card Style="{StaticResource Tarjeta}">
                        <DockPanel>
                            <Border Style="{StaticResource IconoKpi}" Background="#2243A047">
                                <md:PackIcon Kind="CashRegister" Width="28" Height="28" Foreground="#43A047" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ventas de hoy" Style="{StaticResource EtiquetaKpi}" />
                                <TextBlock Text="{Binding Ventas.Hoy, Converter={StaticResource Moneda}}" Style="{StaticResource ValorKpi}" />
                            </StackPanel>
                        </DockPanel>
                    </md:Card>
                    <md:Card Style="{StaticResource Tarjeta}">
                        <DockPanel>
                            <Border Style="{StaticResource IconoKpi}" Background="#221E88E5">
                                <md:PackIcon Kind="CalendarWeek" Width="28" Height="28" Foreground="#1E88E5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Últimos 7 días" Style="{StaticResource EtiquetaKpi}" />
                                <TextBlock Text="{Binding Ventas.UltimosSieteDias, Converter={StaticResource Moneda}}" Style="{StaticResource ValorKpi}" />
                            </StackPanel>
                        </DockPanel>
                    </md:Card>
                    <md:Card Style="{StaticResource Tarjeta}">
                        <DockPanel>
                            <Border Style="{StaticResource IconoKpi}" Background="#225E35B1">
                                <md:PackIcon Kind="ChartLine" Width="28" Height="28" Foreground="#5E35B1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ventas del mes" Style="{StaticResource EtiquetaKpi}" />
                                <TextBlock Text="{Binding Ventas.EsteMes, Converter={StaticResource Moneda}}" Style="{StaticResource ValorKpi}" />
                            </StackPanel>
                        </DockPanel>
                    </md:Card>
                    <md:Card Style="{StaticResource Tarjeta}">
                        <DockPanel>
                            <Border Style="{StaticResource IconoKpi}" Background="#2200897B">
                                <md:PackIcon Kind="ScaleBalance" Width="28" Height="28" Foreground="#00897B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Balance (ingresos - gastos)" Style="{StaticResource EtiquetaKpi}" />
                                <TextBlock Text="{Binding Resumen.Balance, Converter={StaticResource Moneda}}" Style="{StaticResource ValorKpi}"
                                           Foreground="{Binding Resumen.Balance, Converter={StaticResource EstadoAColor}}" />
                            </StackPanel>
                        </DockPanel>
                    </md:Card>
                    <md:Card Style="{StaticResource Tarjeta}">
                        <DockPanel>
                            <Border Style="{StaticResource IconoKpi}" Background="#228E24AA">
                                <md:PackIcon Kind="AccountCash" Width="28" Height="28" Foreground="#8E24AA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Nómina mensual" Style="{StaticResource EtiquetaKpi}" />
                                <TextBlock Text="{Binding Resumen.NominaMensual, Converter={StaticResource Moneda}}" Style="{StaticResource ValorKpi}" />
                            </StackPanel>
                        </DockPanel>
                    </md:Card>
                    <md:Card Style="{StaticResource Tarjeta}">
                        <DockPanel>
                            <Border Style="{StaticResource IconoKpi}" Background="#2200ACC1">
                                <md:PackIcon Kind="AccountGroup" Width="28" Height="28" Foreground="#00ACC1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Trabajadores activos" Style="{StaticResource EtiquetaKpi}" />
                                <TextBlock Text="{Binding Resumen.TrabajadoresActivos}" Style="{StaticResource ValorKpi}" />
                            </StackPanel>
                        </DockPanel>
                    </md:Card>
                    <md:Card Style="{StaticResource Tarjeta}">
                        <DockPanel>
                            <Border Style="{StaticResource IconoKpi}" Background="#22FB8C00">
                                <md:PackIcon Kind="PackageVariantClosed" Width="28" Height="28" Foreground="#FB8C00" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Productos (con stock bajo)" Style="{StaticResource EtiquetaKpi}" />
                                <TextBlock Style="{StaticResource ValorKpi}">
                                    <Run Text="{Binding Resumen.Productos, Mode=OneWay}" /><Run Text="  (" FontSize="16" FontWeight="Normal" /><Run Text="{Binding Resumen.ProductosStockBajo, Mode=OneWay}" FontSize="16" Foreground="#FB8C00" /><Run Text=")" FontSize="16" FontWeight="Normal" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </md:Card>
                    <md:Card Style="{StaticResource Tarjeta}">
                        <DockPanel>
                            <Border Style="{StaticResource IconoKpi}" Background="#22D81B60">
                                <md:PackIcon Kind="FileAccountOutline" Width="28" Height="28" Foreground="#D81B60" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Hojas de vida nuevas" Style="{StaticResource EtiquetaKpi}" />
                                <TextBlock Text="{Binding Resumen.PostulacionesNuevas}" Style="{StaticResource ValorKpi}" />
                            </StackPanel>
                        </DockPanel>
                    </md:Card>
                </UniformGrid>

                <!-- ============ Graficas: ventas por dia y estado del inventario ============ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <md:Card Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding VentasCatorceDias}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="ChartAreaspline" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Ventas de los últimos 14 días" Style="{StaticResource TituloTarjeta}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                            <c:GraficaLinea Datos="{Binding VentasPorDia}" Height="250" Relleno="{DynamicResource PrimaryHueMidBrush}"
                                            Background="{DynamicResource MaterialDesignCardBackground}" TextoVacio="Aún no hay ventas en los últimos 14 días" />
                        </StackPanel>
                    </md:Card>
                    <md:Card Grid.Column="1" Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <md:PackIcon Kind="ChartDonut" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Estado del inventario" Style="{StaticResource TituloTarjeta}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <c:GraficaDona Datos="{Binding EstadoInventario}" Height="180" Moneda="False" Centro="{Binding TotalProductos}" CentroDetalle="productos"
                                           Background="{DynamicResource MaterialDesignCardBackground}" TextoVacio="Aún no hay productos" />
                            <ItemsControl ItemsSource="{Binding EstadoInventario}" ItemTemplate="{StaticResource Leyenda}" Margin="0,12,0,0" />
                        </StackPanel>
                    </md:Card>
                </Grid>

                <!-- ============ Ingresos vs gastos y gastos por categoria ============ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <md:Card Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="12" Height="12" CornerRadius="4" Background="#43A047" />
                                    <TextBlock Text="Ingresos" Margin="6,0,14,0" />
                                    <Border Width="12" Height="12" CornerRadius="4" Background="#E53935" />
                                    <TextBlock Text="Gastos" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="ChartBar" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Ingresos vs. gastos (6 meses)" Style="{StaticResource TituloTarjeta}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                            <c:GraficaBarras Datos="{Binding IngresosGastos}" Height="250" Relleno="#43A047" Relleno2="#E53935"
                                             Serie1="Ingresos" Serie2="Gastos" TextoVacio="Aún no hay ingresos ni gastos registrados" />
                        </StackPanel>
                    </md:Card>
                    <md:Card Grid.Column="1" Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <md:PackIcon Kind="ChartPie" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="¿En qué se va la plata? (gastos por categoría)" Style="{StaticResource TituloTarjeta}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <c:GraficaDona Datos="{Binding GastosPorCategoria}" Height="230" Centro="{Binding TotalGastos}" CentroDetalle="en gastos"
                                               Background="{DynamicResource MaterialDesignCardBackground}" TextoVacio="Aún no hay gastos" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding GastosPorCategoria}" ItemTemplate="{StaticResource Leyenda}"
                                              VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </md:Card>
                </Grid>

                <!-- ============ Mas vendidos y stock bajo ============ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <md:Card Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <md:PackIcon Kind="Trophy" Width="22" Height="22" Foreground="#FFB300" VerticalAlignment="Center" />
                                <TextBlock Text="Productos más vendidos" Style="{StaticResource TituloTarjeta}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <c:GraficaBarras Datos="{Binding TopProductos}" Horizontal="True" Moneda="False" Height="230"
                                             TextoVacio="Aún no hay ventas" />
                        </StackPanel>
                    </md:Card>
                    <md:Card Grid.Column="1" Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <md:PackIcon Kind="AlertCircleOutline" Width="22" Height="22" Foreground="#FB8C00" VerticalAlignment="Center" />
                                <TextBlock Text="Productos con stock bajo" Style="{StaticResource TituloTarjeta}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding StockBajo}" Style="{StaticResource Tabla}" MaxHeight="230">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*" />
                                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" />
                                    <DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimo}" />
                                    <DataGridTextColumn Header="Faltan" Binding="{Binding Faltante}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="✔ Todos los productos tienen stock suficiente." Opacity="0.7" Margin="4,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StockBajo.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </md:Card>
                </Grid>

                <md:Card Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <md:PackIcon Kind="PiggyBankOutline" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Presupuestos en alerta este mes" Style="{StaticResource TituloTarjeta}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Alertas}" Style="{StaticResource Tabla}" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="*" />
                                <DataGridTextColumn Header="Uso" Binding="{Binding PorcentajeUso, Converter={StaticResource Porcentaje}}" />
                                <DataGridTemplateColumn Header="Estado">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Estado}" FontWeight="SemiBold" Foreground="{Binding Estado, Converter={StaticResource EstadoAColor}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="✔ Ningún presupuesto está en alerta." Opacity="0.7" Margin="4,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Alertas.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </md:Card>
            </StackPanel>

            <md:Card Style="{StaticResource Tarjeta}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <md:PackIcon Kind="StorefrontOutline" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Todos mis emprendimientos" Style="{StaticResource TituloTarjeta}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Todos}" Style="{StaticResource Tabla}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Emprendimiento" Binding="{Binding Nombre}" Width="2*" />
                            <DataGridTextColumn Header="Sector" Binding="{Binding Sector}" Width="*" />
                            <DataGridTextColumn Header="Trabajadores" Binding="{Binding TrabajadoresActivos}" />
                            <DataGridTextColumn Header="Productos" Binding="{Binding Productos}" />
                            <DataGridTextColumn Header="Stock bajo" Binding="{Binding ProductosStockBajo}" />
                            <DataGridTextColumn Header="Ventas del mes" Binding="{Binding VentasDelMes}" />
                            <DataGridTextColumn Header="Balance" Binding="{Binding Balance, Converter={StaticResource Moneda}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </md:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
