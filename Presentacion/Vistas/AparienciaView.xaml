<UserControl x:Class="Presentacion.Vistas.AparienciaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:c="clr-namespace:Presentacion.Comun"
             xmlns:vm="clr-namespace:Presentacion.ViewModels">
    <UserControl.Resources>
        <!-- Boton redondo sin decoracion para las muestras de color -->
        <Style x:Key="Muestra" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Aro" Padding="4" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Aro" Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tarjeta grande para elegir modo claro u oscuro -->
        <Style x:Key="BotonModo" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Caja" CornerRadius="14" BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}"
                                Background="{TemplateBinding Background}" Padding="16,14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Elegido">
                                <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                                <Setter TargetName="Caja" Property="BorderThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Apariencia" Style="{StaticResource TituloSeccion}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Subtitulo}" Margin="0,0,0,18"
                           Text="Personaliza los colores de SGAPE. Los cambios se ven al instante y se guardan en este computador." />

                <!-- Modo -->
                <md:Card Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Modo" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,12" />
                        <UniformGrid Columns="2">
                            <Button Command="{Binding ModoClaroCommand}" Margin="0,0,8,0" Background="#FAFAFA">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BotonModo}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Oscuro}" Value="False"><Setter Property="Tag" Value="Elegido" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="WhiteBalanceSunny" Width="34" Height="34" Foreground="#FB8C00" VerticalAlignment="Center" />
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock Text="Claro" FontSize="17" FontWeight="SemiBold" Foreground="#212121" />
                                        <TextBlock Text="Fondo claro, ideal de día" Foreground="#616161" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ModoOscuroCommand}" Margin="8,0,0,0" Background="#1E2227">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BotonModo}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Oscuro}" Value="True"><Setter Property="Tag" Value="Elegido" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="WeatherNight" Width="34" Height="34" Foreground="#90CAF9" VerticalAlignment="Center" />
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock Text="Oscuro" FontSize="17" FontWeight="SemiBold" Foreground="White" />
                                        <TextBlock Text="Descansa la vista de noche" Foreground="#B0BEC5" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </md:Card>

                <!-- Color principal -->
                <md:Card Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Color de los botones y del menú" Style="{StaticResource TituloTarjeta}" />
                        <TextBlock Text="Se usa en el menú lateral, los botones, los títulos y las gráficas." Opacity="0.7" Margin="0,4,0,14" />
                        <ItemsControl ItemsSource="{Binding Principales}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type c:OpcionColor}">
                                    <Button Style="{StaticResource Muestra}" ToolTip="{Binding Nombre}" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.ElegirPrincipalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Grid Width="42" Height="42">
                                            <Ellipse Fill="{Binding Pincel}" />
                                            <md:PackIcon Kind="Check" Foreground="White" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <md:PackIcon.Visibility>
                                                    <MultiBinding Converter="{StaticResource IgualesAVisible}">
                                                        <Binding Path="Hex" />
                                                        <Binding Path="DataContext.PrincipalActual" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </md:PackIcon.Visibility>
                                            </md:PackIcon>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBox Text="{Binding HexPrincipal, UpdateSourceTrigger=PropertyChanged}" Width="190" FontSize="15"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="Color personalizado (#1E88E5)" />
                            <Button Content="Aplicar" Command="{Binding AplicarPrincipalCommand}" Style="{StaticResource BotonPrincipal}"
                                    Margin="10,0,0,0" VerticalAlignment="Top" Height="42" />
                        </StackPanel>
                        <TextBlock Text="{Binding ErrorPrincipal}" Foreground="#E53935" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ErrorPrincipal, Converter={StaticResource NuloAVisible}}" />
                    </StackPanel>
                </md:Card>

                <!-- Fondo -->
                <md:Card Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Color del fondo" Style="{StaticResource TituloTarjeta}" />
                        <TextBlock Text="El fondo de las pantallas. Las tarjetas quedan encima para que todo se lea bien." Opacity="0.7" Margin="0,4,0,14" />
                        <ItemsControl ItemsSource="{Binding Fondos}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type c:OpcionColor}">
                                    <Button Style="{StaticResource Muestra}" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.ElegirFondoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <StackPanel Width="78">
                                            <Grid Height="48">
                                                <Border CornerRadius="10" Background="{Binding Pincel}" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}" />
                                                <Border CornerRadius="5" Background="{DynamicResource MaterialDesignCardBackground}" Margin="14,12" Opacity="0.95" />
                                                <md:PackIcon Kind="CheckCircle" Foreground="{DynamicResource PrimaryHueMidBrush}" Width="22" Height="22"
                                                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0">
                                                    <md:PackIcon.Visibility>
                                                        <MultiBinding Converter="{StaticResource IgualesAVisible}">
                                                            <Binding Path="Hex" />
                                                            <Binding Path="DataContext.FondoActual" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        </MultiBinding>
                                                    </md:PackIcon.Visibility>
                                                </md:PackIcon>
                                            </Grid>
                                            <TextBlock Text="{Binding Nombre}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBox Text="{Binding HexFondo, UpdateSourceTrigger=PropertyChanged}" Width="190" FontSize="15"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="Fondo personalizado (#F3F6F9)" />
                            <Button Content="Aplicar" Command="{Binding AplicarFondoCommand}" Style="{StaticResource BotonPrincipal}"
                                    Margin="10,0,0,0" VerticalAlignment="Top" Height="42" />
                        </StackPanel>
                        <TextBlock Text="{Binding ErrorFondo}" Foreground="#E53935" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ErrorFondo, Converter={StaticResource NuloAVisible}}" />
                    </StackPanel>
                </md:Card>

                <!-- Acento -->
                <md:Card Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Color de acento" Style="{StaticResource TituloTarjeta}" />
                        <TextBlock Text="Detalles que resaltan: la marca del menú, el botón del plan, interruptores y selecciones." Opacity="0.7" Margin="0,4,0,14" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Acentos}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type c:OpcionColor}">
                                    <Button Style="{StaticResource Muestra}" ToolTip="{Binding Nombre}" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.ElegirAcentoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Grid Width="36" Height="36">
                                            <Ellipse Fill="{Binding Pincel}" />
                                            <md:PackIcon Kind="Check" Foreground="White" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <md:PackIcon.Visibility>
                                                    <MultiBinding Converter="{StaticResource IgualesAVisible}">
                                                        <Binding Path="Hex" />
                                                        <Binding Path="DataContext.AcentoActual" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </md:PackIcon.Visibility>
                                            </md:PackIcon>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </md:Card>

                <!-- Tamaño -->
                <md:Card Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Tamaño de letra y botones" Style="{StaticResource TituloTarjeta}" />
                        <TextBlock Text="Agranda toda la aplicación si las letras se ven pequeñas." Opacity="0.7" Margin="0,4,0,14" />
                        <ItemsControl ItemsSource="{Binding Escalas}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OpcionEscala}">
                                    <Button Style="{StaticResource BotonBarra}" Margin="0,0,10,8" Height="44" Padding="16,0" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.ElegirEscalaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="CheckCircle" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <md:PackIcon.Visibility>
                                                    <MultiBinding Converter="{StaticResource IgualesAVisible}">
                                                        <Binding Path="Clave" />
                                                        <Binding Path="DataContext.EscalaActual" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </md:PackIcon.Visibility>
                                            </md:PackIcon>
                                            <TextBlock Text="{Binding Nombre}" FontSize="15" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </md:Card>

                <Button Command="{Binding RestablecerCommand}" Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Restore" VerticalAlignment="Center" />
                        <TextBlock Text="Restablecer los colores de SGAPE" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Vista previa: se actualiza sola con cada cambio -->
        <md:Card Grid.Column="1" Style="{StaticResource Tarjeta}" VerticalAlignment="Top" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Vista previa" Style="{StaticResource TituloTarjeta}" Margin="0,0,0,14" />
                <md:ColorZone Mode="PrimaryDark" CornerRadius="12" Padding="14,12">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="StorefrontOutline" Width="24" Height="24" VerticalAlignment="Center" />
                        <TextBlock Text="SGAPE" FontSize="18" FontWeight="Black" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </md:ColorZone>

                <Border CornerRadius="12" Background="{DynamicResource MaterialDesignPaper}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <md:Card UniformCornerRadius="12" Padding="14">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconoKpi}" Width="44" Height="44" Background="{DynamicResource PrimaryHueMidBrush}">
                                    <md:PackIcon Kind="CashRegister" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ventas de hoy" Style="{StaticResource EtiquetaKpi}" />
                                    <TextBlock Text="$ 720.000" FontSize="22" FontWeight="Bold" />
                                </StackPanel>
                            </StackPanel>
                        </md:Card>
                        <md:Card UniformCornerRadius="12" Padding="10" Margin="0,10,0,0">
                            <c:GraficaBarras Datos="{Binding Muestra}" Height="130" Relleno="{DynamicResource PrimaryHueMidBrush}" />
                        </md:Card>
                    </StackPanel>
                </Border>

                <WrapPanel Margin="0,14,0,0">
                    <Button Content="Botón" Style="{StaticResource BotonPrincipal}" Margin="0,0,8,8" />
                    <Button Content="Secundario" Style="{StaticResource BotonBarra}" Margin="0,0,8,8" />
                    <Button Content="Acento" Style="{StaticResource MaterialDesignRaisedSecondaryButton}" md:ButtonAssist.CornerRadius="10" Margin="0,0,8,8" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="True" />
                    <TextBlock Text="Interruptor" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </md:Card>
    </Grid>
</UserControl>
