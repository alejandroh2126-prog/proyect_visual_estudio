<Application x:Class="Presentacion.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:c="clr-namespace:Presentacion.Comun"
             xmlns:vm="clr-namespace:Presentacion.ViewModels"
             xmlns:v="clr-namespace:Presentacion.Vistas"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <md:BundledTheme BaseTheme="Light" PrimaryColor="Teal" SecondaryColor="Amber" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Convertidores -->
            <BooleanToVisibilityConverter x:Key="BoolAVisible" />
            <c:MonedaConverter x:Key="Moneda" />
            <c:PorcentajeConverter x:Key="Porcentaje" />
            <c:FechaConverter x:Key="Fecha" />
            <c:EstadoAColorConverter x:Key="EstadoAColor" />
            <c:NuloAVisibleConverter x:Key="NuloAVisible" />
            <c:TipoCampoAVisibleConverter x:Key="TipoCampoAVisible" />
            <c:EstadoPostulacionConverter x:Key="EstadoPostulacion" />
            <c:TamanoConverter x:Key="Tamano" />
            <c:IgualesAVisibleConverter x:Key="IgualesAVisible" />
            <c:BoolAVisibleInvertidoConverter x:Key="BoolAInvisible" />

            <!-- Tamaño de toda la interfaz (seccion Apariencia). Apariencia.Aplicar lo reemplaza. -->
            <ScaleTransform x:Key="EscalaInterfaz" ScaleX="1" ScaleY="1" />

            <!-- Estilos propios -->
            <Style x:Key="TituloSeccion" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignHeadline5TextBlock}">
                <Setter Property="Margin" Value="0,0,0,14" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
            </Style>
            <Style x:Key="Subtitulo" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Opacity" Value="0.72" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="TituloTarjeta" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="BotonBarra" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="md:ButtonAssist.CornerRadius" Value="10" />
            </Style>
            <Style x:Key="BotonPrincipal" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="md:ButtonAssist.CornerRadius" Value="10" />
            </Style>
            <Style x:Key="Tarjeta" TargetType="md:Card">
                <Setter Property="Padding" Value="20" />
                <Setter Property="Margin" Value="0,0,14,14" />
                <Setter Property="UniformCornerRadius" Value="16" />
                <Setter Property="md:ElevationAssist.Elevation" Value="Dp2" />
            </Style>
            <Style x:Key="EtiquetaKpi" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="ValorKpi" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <!-- Circulo de color con el icono de cada indicador (Tag = color) -->
            <Style x:Key="IconoKpi" TargetType="Border">
                <Setter Property="Width" Value="52" />
                <Setter Property="Height" Value="52" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Margin" Value="0,0,14,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- Leyenda de las graficas (color, nombre, valor y porcentaje) -->
            <DataTemplate x:Key="Leyenda" DataType="{x:Type c:PuntoGrafica}">
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="12" Height="12" CornerRadius="4" Background="{Binding Color}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Etiqueta}" Margin="8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold">
                        <Run Text="{Binding Texto, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Porcentaje, Mode=OneWay}" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    </TextBlock>
                </Grid>
            </DataTemplate>
            <Style x:Key="Tabla" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="md:DataGridAssist.CellPadding" Value="12,9" />
                <Setter Property="md:DataGridAssist.ColumnHeaderPadding" Value="12,10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style x:Key="Buscador" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="Width" Value="260" />
                <Setter Property="md:HintAssist.Hint" Value="Buscar" />
                <Setter Property="md:TextFieldAssist.HasClearButton" Value="True" />
                <Setter Property="Padding" Value="8,6" />
            </Style>

            <!-- Cada ViewModel se dibuja con su vista (MVVM) -->
            <DataTemplate DataType="{x:Type vm:InicioViewModel}"><v:InicioView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:EmprendimientosViewModel}"><v:EmprendimientosView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:NominaViewModel}"><v:NominaView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:VacantesViewModel}"><v:VacantesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:InventarioViewModel}"><v:InventarioView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:VentasViewModel}"><v:VentasView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:FinanzasViewModel}"><v:FinanzasView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PresupuestosViewModel}"><v:PresupuestosView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportesViewModel}"><v:ReportesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AsistenteViewModel}"><v:AsistenteView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MiPlanViewModel}"><v:MiPlanView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TelegramViewModel}"><v:TelegramView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AparienciaViewModel}"><v:AparienciaView /></DataTemplate>
            <DataTemplate DataType="{x:Type c:FormularioViewModel}"><c:FormularioDialogo /></DataTemplate>
            <DataTemplate DataType="{x:Type c:ConfirmacionViewModel}"><c:ConfirmacionDialogo /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
